@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Container Diagram - Telemetry Service Internals

Person(user, "Пользователь", "Мобильное приложение")

System_Ext(kafka, "Kafka", "device.telemetry topic")
System_Ext(redis_db, "Redis", "Sorted Sets")
System_Ext(api_gateway, "API Gateway")

Container_Boundary(telemetry_service, "Telemetry Service") {
    Container(api, "API Layer", "FastAPI", "REST endpoints, порт 8003, /docs")

    Boundary(kafka_layer, "Kafka Layer") {
        Component(consumer, "TelemetryConsumer", "Python Class", "Подключение к Kafka;Чтение сообщений;Обработка батчей;Retry логика")
    }

    Boundary(storage_layer, "Storage Layer") {
        Component(store, "TelemetryStore", "Python Class", "Подключение к Redis;Сохранение точек;Чтение истории;Последние значения")
        Component(redis_client, "Redis Client", "redis.asyncio", "Pipeline операции")
    }

    Boundary(models, "Models Layer") {
        Component(telemetry_point, "TelemetryPoint", "Pydantic", "time: str, value: float")
        Component(telemetry_response, "TelemetryResponse", "Pydantic", "device_id, metric, data")
        Component(raw_message, "RawTelemetryMessage", "Pydantic", "device_id, timestamp, payload")
    }

    Boundary(config, "Configuration") {
        Component(settings, "Settings", "Pydantic Settings", "KAFKA_SERVERS")
    }

    Component(deps, "Dependencies", "FastAPI Depends", "get_store()")
}

Rel(user, api_gateway, "HTTPS")
Rel(api_gateway, api, "X-User-ID")

Rel(kafka, consumer, "consumes", "JSON messages")
Rel(consumer, store, "save_batch()", "telemetry points")
Rel(store, redis_client, "uses")
Rel(redis_client, redis_db, "Redis protocol")

Rel(api, deps, "uses")
Rel(deps, store, "injects")
Rel(api, store, "get_history() / get_latest()")

Rel(consumer, raw_message, "validates")
Rel(api, telemetry_response, "returns")

Rel(consumer, settings, "reads")
Rel(store, settings, "reads")

@enduml