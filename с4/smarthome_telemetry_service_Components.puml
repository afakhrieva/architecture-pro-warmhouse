@startuml

title Диаграмма компонентов Telemetry Service

top to bottom direction

!include <C4/C4_Component>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(client, "Клиент", "Мобильное приложение")
System_Ext(ApiGateway, "API Gateway", "Проксирует запросы и проверяет токены")
SystemQueue_Ext(EventBus, "Внутренняя шина событий", "kafka")

Container_Boundary(telemetry_service, "Telemetry Service") {
    Component(TelemetryApi, "Telemetry API контроллер", "HTTP Handlers", "Обрабатывает запросы телеметрии от пользователя")
    Component(TelemetryConsumer, "Telemetry Consume and Store Logic", "Сервисный слой", "Читает топик с телеметрией, сохраняет в хранилище")
    ComponentDb(TelemetryStore, "Telemetry Store", "Redis")

    Rel(TelemetryConsumer, TelemetryStore, " ")
    Rel(TelemetryApi, TelemetryStore, " ")
}

Rel(client, ApiGateway, "Запрос", "https")
Rel(ApiGateway, TelemetryApi, "/telemetry*", "http")

Rel(EventBus, TelemetryConsumer, "topic=device.telemetry")

@enduml